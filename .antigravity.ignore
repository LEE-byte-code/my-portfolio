# 🚫 Antigravity Agent Context Exclusion Rules

# Dependency Trees
node_modules/
jspm_packages/
web_modules/

# Next.js & Build Outputs
.next/
dist/
build/
out/
.turbo/
.cache/

# AI Context Bloat: Lockfiles
# (Keeps the AI from wasting tokens reading millions of lines of dependency hashes)
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Local Environment Variables & Secrets
# (Crucial to prevent the AI from accidentally reading or leaking API keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs and Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Heavy Media & Assets
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.mp4
*.pdf
*.zip
*.tar.gz